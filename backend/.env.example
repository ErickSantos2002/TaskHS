DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=/app/uploads
# Origens permitidas no CORS (separadas por vírgula). Em produção, inclua o domínio do frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Integração externa (espelhamento de cards). Gere com: openssl rand -hex 32
# Vazio = integração desligada (endpoints /api/integration respondem 401).
INTEGRATION_API_KEY=

# SSO Microsoft (Entra ID) — App Registration "TaskHS", single tenant, User.Read
# Deixe vazio para desligar o login com Microsoft.
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
FRONTEND_URL=http://localhost:5173
