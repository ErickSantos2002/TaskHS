# Senhas das contas usadas nas baterias de verificação (curl/navegador).
#
# POR QUE ISTO EXISTE: este repositório é PÚBLICO. Em 2026-07-16 descobrimos que as
# senhas de login de contas REAIS de produção estavam versionadas em 12 arquivos
# (CLAUDE.md, .claude/settings.json e 10 planos), públicas no GitHub desde junho — e
# funcionando no site no ar. Senha nunca mais entra em arquivo versionado.
#
# COMO USAR:
#   cp backend/.env.dev-users.example backend/.env.dev-users
#   # preencha as senhas reais no arquivo copiado (ele é gitignorado)
#   set -a; source backend/.env.dev-users; set +a
#
# Aí as baterias dos planos funcionam:
#   ADMIN=$(tok "$TASKHS_ADMIN_EMAIL" "$TASKHS_ADMIN_PW")

TASKHS_ADMIN_EMAIL=
TASKHS_ADMIN_PW=

TASKHS_COORD_EMAIL=
TASKHS_COORD_PW=

TASKHS_MEMBRO_EMAIL=
TASKHS_MEMBRO_PW=
